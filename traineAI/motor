#include <Arduino.h>
#include <HardwareSerial.h>

#define STEP_PIN 4
#define DIR_PIN 19
#define ENA_PIN 18


void setup() {
  pinMode(ENA_PIN, OUTPUT);
  pinMode(DIR_PIN, OUTPUT);
  pinMode(STEP_PIN, OUTPUT);

  // ปลดล็อกมอเตอร์ (free spin)
  digitalWrite(ENA_PIN, HIGH);
}

void loop() {
  // ถ้าอยากสั่งให้มอเตอร์หมุน:
  // 1. ล็อกก่อน
  digitalWrite(ENA_PIN, LOW);
  delay(5); // รอ driver พร้อม

  // 2. กำหนดทิศทาง
  digitalWrite(DIR_PIN, HIGH); // หรือ LOW = สลับทิศ

  // 3. ส่ง pulse
  for (int i = 0; i < 200; i++) {
    digitalWrite(STEP_PIN, HIGH);
    delayMicroseconds(2000);
    digitalWrite(STEP_PIN, LOW);
    delayMicroseconds(2000);
  }

  // 4. ปลดล็อกหลังใช้งาน
  digitalWrite(ENA_PIN, HIGH);
  delay(2000);
}